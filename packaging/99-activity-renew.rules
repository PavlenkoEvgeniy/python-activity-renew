# Доступ к виртуальной мыши activity-renew для пользователя активной сессии.
#
# Композитор читает устройства ввода как пользователь, а узел, созданный через
# /dev/uinput, получает права root:input без ACL — без этого правила Mutter
# устройство не видит, и режим uinput молча ничего не делает.
#
# Правило привязано к имени устройства, поэтому доступ к настоящим клавиатурам
# и мышам не расширяется.
KERNEL=="event*", SUBSYSTEM=="input", ATTRS{name}=="activity-renew*", TAG+="uaccess"
